diff --git a/app/src/main/java/com/example/dreamdiary/navigation/AppNavHost.kt b/app/src/main/java/com/example/dreamdiary/navigation/AppNavHost.kt
index e0a865d..da9ac67 100644
--- a/app/src/main/java/com/example/dreamdiary/navigation/AppNavHost.kt
+++ b/app/src/main/java/com/example/dreamdiary/navigation/AppNavHost.kt
@@ -1,5 +1,8 @@
 package com.example.dreamdiary.navigation
 
+import androidx.compose.animation.core.tween
+import androidx.compose.animation.fadeIn
+import androidx.compose.animation.fadeOut
 import androidx.compose.runtime.Composable
 import androidx.compose.ui.Modifier
 import androidx.navigation.NavHostController
@@ -26,7 +29,14 @@ fun AppNavHost(
     NavHost(
         navController = navController,
         startDestination = Destination.Home.route,
-        modifier = modifier
+        modifier = modifier,
+        // «Fade through»: старый экран быстро гаснет, затем проявляется новый.
+        // Экраны прозрачные (фон лежит под Scaffold), поэтому они не должны
+        // быть видны одновременно - иначе тексты накладываются и мерцают.
+        enterTransition = { fadeIn(tween(durationMillis = 210, delayMillis = 90)) },
+        exitTransition = { fadeOut(tween(durationMillis = 90)) },
+        popEnterTransition = { fadeIn(tween(durationMillis = 210, delayMillis = 90)) },
+        popExitTransition = { fadeOut(tween(durationMillis = 90)) }
     ) {
         composable(Destination.Home.route) {
             HomeScreen(navController = navController, onAddDreamClick = onAddDreamClick)
diff --git a/app/src/main/java/com/example/dreamdiary/navigation/NavigationBarExample.kt b/app/src/main/java/com/example/dreamdiary/navigation/NavigationBarExample.kt
index 187ce53..2757cc3 100644
--- a/app/src/main/java/com/example/dreamdiary/navigation/NavigationBarExample.kt
+++ b/app/src/main/java/com/example/dreamdiary/navigation/NavigationBarExample.kt
@@ -1,5 +1,7 @@
 package com.example.dreamdiary.navigation
 
+import androidx.compose.animation.Crossfade
+import androidx.compose.animation.core.tween
 import androidx.compose.foundation.Image
 import androidx.compose.foundation.layout.Box
 import androidx.compose.foundation.layout.fillMaxSize
@@ -49,19 +51,25 @@ fun NavigationBarExample(
 
     Box(modifier = Modifier.fillMaxSize()) {
 
-        // Фоновое изображение в зависимости от темы
-        Image(
-            painter = painterResource(
-                id = if (isDarkTheme) {
-                    R.drawable.dream_background_dark
-                } else {
-                    R.drawable.dream_background_light
-                }
-            ),
-            contentDescription = null,
-            modifier = Modifier.fillMaxSize(),
-            contentScale = ContentScale.Crop
-        )
+        // Фоновое изображение в зависимости от темы (плавная смена без «щелчка»)
+        Crossfade(
+            targetState = isDarkTheme,
+            animationSpec = tween(300),
+            label = "background"
+        ) { dark ->
+            Image(
+                painter = painterResource(
+                    id = if (dark) {
+                        R.drawable.dream_background_dark
+                    } else {
+                        R.drawable.dream_background_light
+                    }
+                ),
+                contentDescription = null,
+                modifier = Modifier.fillMaxSize(),
+                contentScale = ContentScale.Crop
+            )
+        }
 
         Scaffold(
             modifier = Modifier.fillMaxSize(),
diff --git a/app/src/main/java/com/example/dreamdiary/screens/ConstellationScreen.kt b/app/src/main/java/com/example/dreamdiary/screens/ConstellationScreen.kt
index 15da4ad..e6e98f0 100644
--- a/app/src/main/java/com/example/dreamdiary/screens/ConstellationScreen.kt
+++ b/app/src/main/java/com/example/dreamdiary/screens/ConstellationScreen.kt
@@ -116,6 +116,11 @@ fun ConstellationScreen() {
         }
     }
 
+    // Считаем связи один раз, а не на каждой перерисовке Canvas
+    val connectedFlags = remember(dreams) {
+        dreams.map { dream -> getConnectedDreams(dream).isNotEmpty() }
+    }
+
     Column(
         modifier = Modifier
             .fillMaxSize()
@@ -212,7 +217,7 @@ fun ConstellationScreen() {
                 }
 
                 dreams.forEachIndexed { index, dream ->
-                    val connected = getConnectedDreams(dream).isNotEmpty()
+                    val connected = connectedFlags[index]
                     val starColor = if (connected) brightStar else ordinaryStar
                     val radius = if (connected) 7.dp.toPx() else 5.dp.toPx()
 
